[gd_resource type="Resource" script_class="SkillContentDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://combat/content/skill_content_definition.gd" id="1_content"]
[ext_resource type="Resource" path="res://resources/skills/elemental_laser.tres" id="2_gameplay"]
[ext_resource type="PackedScene" path="res://combat/delivery/element_beam_delivery.tscn" id="3_delivery"]
[ext_resource type="Texture2D" path="res://assets/generated/vfx/elemental_laser/icon.png" id="4_icon"]
[ext_resource type="PackedScene" path="res://scenes/vfx/elemental_laser_presentation.tscn" id="5_presentation"]

[resource]
script = ExtResource("1_content")
skill_id = &"elemental_laser"
display_name = "元素激光"
description = "持续引导；每0.5秒消耗5点能量，对光束内全部目标造成50%攻击力伤害并附着1层锁定元素。"
icon = ExtResource("4_icon")
presentation_scene = ExtResource("5_presentation")
gameplay_definition = ExtResource("2_gameplay")
runtime_delivery_scene = ExtResource("3_delivery")
reward_pool = true
initial_reward_pool = true
allowed_form_ids = Array[StringName]([&"water", &"fire"])

