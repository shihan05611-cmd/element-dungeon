upgrade_price = 60
damage_scale = 1.2

[sub_resource type="Resource" id="IgnitionLv3"]
script = ExtResource("4_level")
level = 3
upgrade_price = 100
damage_scale = 1.4

[sub_resource type="Resource" id="IgnitionProgression"]
script = ExtResource("5_progression")
