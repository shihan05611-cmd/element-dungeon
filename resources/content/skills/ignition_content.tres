[resource]
script = ExtResource("1_content")
skill_id = &"ignition"
display_name = "引燃"
description = "吸收可见敌人的全部火元素，8 秒内普攻按吸收层数强化并固定附着 1 层火。"
icon = ExtResource("3_icon")
gameplay_definition = ExtResource("2_gameplay")
initially_owned = true
default_slot_id = &"active_2"
allowed_form_ids = Array[StringName]([&"fire"])
active_progression = SubResource("IgnitionProgression")
